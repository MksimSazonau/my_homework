(
    -- 1. Ищем самого молодого медалиста
    SELECT 'Самый молодой' as type, name, sex, ROUND(age::NUMERIC) as final_age, team, games, sport, event, medal
    FROM study_db_scheme.athletes_summer_games
    WHERE age IS NOT NULL 
      AND age != 'NA' 
      AND age != ''  -- Игнорируем абсолютно пустые строки
      AND medal IS NOT NULL 
      AND medal NOT IN ('NA', 'No medal')
    ORDER BY age::NUMERIC ASC
    LIMIT 1
)
UNION ALL
(
    -- 2. Ищем самого пожилого медалиста
    SELECT 'Самый пожилой' as type, name, sex, ROUND(age::NUMERIC) as final_age, team, games, sport, event, medal
    FROM study_db_scheme.athletes_summer_games
    WHERE age IS NOT NULL 
      AND age != 'NA' 
      AND age != ''  -- Игнорируем абсолютно пустые строки
      AND medal IS NOT NULL 
      AND medal NOT IN ('NA', 'No medal')
    ORDER BY age::NUMERIC DESC
    LIMIT 1
);
